# --- Stroka Studio (private budgets app) ---
# Login user
STUDIO_USER=admin
# Generate with:  npm run studio:hash -- "your-long-password"
STUDIO_PASSWORD_HASH=
# >= 32 chars random. Generated by the same command. Changing it logs everyone out.
STUDIO_SESSION_SECRET=
# Postgres connection string (Neon / Supabase / Vercel Postgres). Required in
# production. Leave empty in local dev to use an embedded DB in ./.data
DATABASE_URL=

# Vercel Blob (home images uploaded from Studio). Optional: without it the
# site keeps working and Studio shows uploads as unavailable. Created
# automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=
